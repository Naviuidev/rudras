# Template only — copy to project root as .env and edit for production.
# deploy.sh uploads your local .env to ~/rudra/.env on the server every deploy.

APP_ENV=production
APP_URL=https://rudrasfarmfresh.in
CORS_ORIGIN=https://rudrasfarmfresh.in

DB_HOST=localhost
DB_NAME=cpanel_db_name
DB_USER=cpanel_db_user
DB_PASS=your_db_password

JWT_SECRET=change-to-long-random-string
JWT_EXPIRY=604800

ADMIN_USERNAME=Rudra
ADMIN_PASSWORD=use-a-strong-production-password

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your@gmail.com
SMTP_FROM_NAME=Rudra's Farm Fresh

SERVICE_AREA_RADIUS_KM=25

WEB_URL=https://rudrasfarmfresh.in
VITE_WEB_API_URL=https://api.rudrasfarmfresh.in/api
VITE_API_URL=https://api.rudrasfarmfresh.in/api

SUPPORT_PHONE=+91 7989149573
SUPPORT_EMAIL=rudrasfarmfresh@gmail.com
SUPPORT_WHATSAPP=+91 7989149573
